{
  "name": "studylink",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "node apps/api/scripts/dev.js",
    "dev:all": "node apps/api/scripts/dev.js",
    "dev:web": "npm run dev --workspace @studylink/web",
    "dev:mobile": "npm run start --workspace @studylink/mobile",
    "dev:mobile:web": "npm run web --workspace @studylink/mobile",
    "dev:api": "npm run server --workspace @studylink/api",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @studylink/web",
    "build:mobile": "npm run build:web --workspace @studylink/mobile",
    "typecheck": "npm run typecheck --workspace @studylink/mobile && npm run typecheck --workspace @studylink/web",
    "smoke": "npm run smoke --workspace @studylink/api",
    "snapshot:content": "node scripts/content-snapshot.mjs",
    "test:api": "npm run test:api --workspace @studylink/api",
    "test": "npm run test:api && npm run build:web && npm run typecheck",
    "migrate": "npm run migrate --workspace @studylink/api",
    "preview:web": "npm run preview --workspace @studylink/web"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "playwright": "^1.64.0"
  }
}
